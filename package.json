{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25",
    "bun": "1.3.14"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --mode production && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --legal-comments=none --outfile=dist/server.cjs && npm run security:artifact && npm run pilot:artifact",
    "build:staging": "vite build --mode staging && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --legal-comments=none --outfile=dist/server.cjs && npm run security:artifact",
    "build:render": "tsx scripts/pilot/run-render-build.ts",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:sec002": "tsx --test tests/sec002-security.test.ts",
    "test:sec003": "tsx --test tests/sec003-secrets.test.ts",
    "test:sec004": "tsx --test tests/sec004-safe-outputs.test.ts",
    "test:sec005": "tsx --test tests/sec005-security-baseline.test.ts",
    "test:db001": "tsx --test tests/db001-baseline.test.ts",
    "test:stabilization": "tsx --test tests/stabilization-regressions.test.ts",
    "test:automations": "tsx --test tests/automation-behavior.test.ts",
    "test:pilot": "tsx --test tests/pilot-readiness.test.ts",
    "test:portal001": "tsx --test tests/portal001-auth-isolation.test.ts",
    "test:referral-loyalty": "tsx --test tests/referral-loyalty.test.ts",
    "test:go-live001": "tsx --test tests/go-live001-deployment.test.ts",
    "go-live:validate-env": "tsx scripts/pilot/validate-go-live-environment.ts",
    "go-live:smtp:check": "tsx scripts/pilot/configure-supabase-auth.ts",
    "go-live:smtp:apply": "tsx scripts/pilot/configure-supabase-auth.ts --apply",
    "pilot:artifact": "tsx scripts/pilot/validate-production-artifact.ts",
    "db:backup:verify": "tsx scripts/database/verify-backup.ts",
    "security:headers": "tsx scripts/security/check-headers.ts",
    "security:secrets": "tsx scripts/security/scan-secrets.ts",
    "security:artifact": "tsx scripts/security/validate-artifact.ts",
    "security:lockfile": "tsx scripts/security/verify-lockfile.ts",
    "security:licenses": "tsx scripts/security/check-licenses.ts",
    "security:dependencies": "npm run security:lockfile && bun audit --audit-level=high && npm run security:licenses",
    "security:outdated": "bun outdated",
    "security:unused": "tsx scripts/security/check-unused-dependencies.ts",
    "security:ci": "npm run build && npm run build && npm run test:sec002 && npm run test:sec003 && npm run test:sec004 && npm run test:sec005 && npm run test:db001 && npm run test:automations && npm run test:stabilization && npm run test:pilot && npm run test:portal001 && npm run test:go-live001 && npm run security:secrets && npm run security:dependencies"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.5",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "@types/express": "^4.17.21"
  }
}
