# Copy only the appropriate environment template:
#   development: .env.development.example
#   staging:     .env.staging.example
#   production:  .env.production.example
#
# Never commit the resulting .env files. Private values must be injected by
# the deployment platform or a secret manager.

APP_ENV="development"
NODE_ENV="development"
PORT="3000"

# Public Supabase configuration. VITE_* values are embedded in the browser
# bundle and must contain only the public publishable/anon key.
SUPABASE_URL="https://project-ref.supabase.co"
SUPABASE_ANON_KEY="<public-anon-key>"
VITE_SUPABASE_URL="https://project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="<public-anon-key>"
VITE_ENABLE_CLIENT_PORTAL="false"

# Optional server-only integrations. Use a secret manager outside development.
MAKE_WEBHOOK_URL="<set-in-secret-manager>"
ZAPI_INSTANCE_ID="<set-in-secret-manager>"
ZAPI_TOKEN="<set-in-secret-manager>"
ZAPI_CLIENT_TOKEN="<set-in-secret-manager>"
